{
  "name": "api-standards",
  "version": "0.1.0",
  "private": true,
  "description": "An HTTP API standard and the Spectral ruleset that enforces it.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0 && pnpm lint:md",
    "lint:md": "markdownlint-cli2",
    "lint:examples": "./.tools/spectral lint --fail-severity=warn --ruleset spectral/api-standards.yaml examples/*.yaml",
    "test": "vitest run",
    "build": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "license-checker-rseidelsohn": "5.0.1",
    "markdownlint-cli2": "0.24.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
